# Copy this file to scripts/.env and fill in the real values.
# scripts/.env is gitignored — NEVER commit real credentials.
#
# Generate the keys in ERPNext:
#   User list > your System Manager user > Settings tab > API Access > Generate Keys
ERPNEXT_URL=https://trias-oceanic.frappe.cloud
ERPNEXT_API_KEY=your_api_key_here
ERPNEXT_API_SECRET=your_api_secret_here
